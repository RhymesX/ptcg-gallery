page {
  background-color: #0f0f23;
  color: #e0e0e0;
  font-size: 28rpx;
  min-height: 100vh;
}

.header {
  background: #1a1a2e;
  padding: 20rpx 30rpx;
  border-bottom: 1px solid #2a2a4a;
}

.navbar {
  display: flex;
  justify-content: space-around;
  background: #1a1a2e;
  padding: 16rpx 0;
  border-top: 1px solid #2a2a4a;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #6b7280;
  font-size: 22rpx;
  padding: 8rpx 0;
}

.nav-item.active {
  color: #f5b700;
}

.nav-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.card-list {
  padding: 20rpx;
}

.card-row {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1px solid #2a2a4a;
}

.card-row:active {
  background: #252550;
}

.card-image {
  width: 100rpx;
  height: 140rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  background: #252550;
}

.card-info {
  flex: 1;
  overflow: hidden;
}

.card-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.card-meta {
  font-size: 24rpx;
  color: #9ca3af;
}

.card-quantity {
  font-size: 32rpx;
  font-weight: bold;
  color: #f5b700;
  min-width: 60rpx;
  text-align: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #f5b700;
  padding: 20rpx 30rpx;
  background: #1a1a2e;
  border-bottom: 1px solid #2a2a4a;
}

button {
  border-radius: 8rpx;
}
