.card-row {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1px solid #2a2a4a;
}

.card-image {
  width: 100rpx;
  height: 140rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  background: #252550;
}

.card-info {
  flex: 1;
  overflow: hidden;
}

.card-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.card-meta {
  font-size: 24rpx;
  color: #9ca3af;
}

.card-quantity {
  font-size: 32rpx;
  font-weight: bold;
  color: #f5b700;
  min-width: 60rpx;
  text-align: center;
}
