.card-title {
  font-size: 36rpx;
  font-weight: bold;
}

.card-code {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.card-image-wrap {
  margin: 20rpx;
  text-align: center;
}

.card-detail-image {
  width: 300rpx;
  height: 420rpx;
  border-radius: 16rpx;
}

.detail-section {
  margin: 20rpx;
  background: #1a1a2e;
  border-radius: 12rpx;
  padding: 20rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  margin-bottom: 16rpx;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
}

.info-value {
  font-size: 28rpx;
}

.quantity-row {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.quantity-item {
  text-align: center;
}

.qty-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
}

.qty-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #f5b700;
}

.free-adjust {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 12rpx;
}

.amount-input {
  width: 120rpx;
  background: #252550;
  border-radius: 8rpx;
  padding: 12rpx;
  color: #e0e0e0;
  text-align: center;
}

.amount-input.small {
  width: 80rpx;
  padding: 8rpx;
}

.action-btn.plus {
  background: #4caf50;
  color: #fff;
}

.action-btn.minus {
  background: #ef6c36;
  color: #fff;
}

.deck-btn {
  margin-bottom: 16rpx;
}

.delete-btn {
  background: #7f1d1d;
  color: #fca5a5;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.modal-content {
  position: relative;
  background: #1a1a2e;
  border-radius: 20rpx 20rpx 0 0;
  padding: 30rpx;
  width: 100%;
  max-height: 70vh;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.deck-list {
  max-height: 300rpx;
  margin-bottom: 20rpx;
}

.deck-option {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  background: #252550;
}

.deck-option.active {
  border: 2px solid #f5b700;
}

.deck-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.action-form {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.modal-actions {
  display: flex;
  gap: 12rpx;
  justify-content: center;
}

.empty-decks {
  text-align: center;
  padding: 40rpx;
  color: #6b7280;
}
