.deck-summary {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.deck-warning {
  font-size: 24rpx;
  color: #f59e0b;
  margin-top: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(245, 158, 10, 0.1);
  border-radius: 8rpx;
  display: inline-block;
}

.deck-warn-area {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

/* 切换按钮 */
.view-toggle {
  display: flex;
  gap: 0;
  margin-top: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  width: 200rpx;
}

.toggle-btn {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  background: #252550;
  color: #9ca3af;
}

.toggle-btn.active {
  background: #f5b700;
  color: #1a1a2e;
}

/* 文字模式 —— 左右两列 */
.text-layout {
  display: flex;
  gap: 20rpx;
}

.text-column {
  flex: 1;
  min-width: 0;
}

.text-card-row {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.text-card-qty {
  width: 48rpx;
  font-weight: bold;
  color: #f5b700;
  flex-shrink: 0;
}

.text-card-name {
  flex: 1;
  color: #e0e0e0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-card-code {
  color: #9ca3af;
  font-size: 22rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 图片模式 —— 网格布局 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 0;
}

.image-card {
  position: relative;
  width: 150rpx;
  height: 210rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #141428;
}

.image-card-img {
  width: 100%;
  height: 100%;
}

.image-card-qty {
  position: absolute;
  bottom: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.85);
  color: #1a1a2e;
  font-size: 24rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 6rpx 0 0 0;
  min-width: 36rpx;
  text-align: center;
}

.content {
  padding: 20rpx;
  padding-bottom: 120rpx;
  height: calc(100vh - 240rpx);
}
