.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.create-btn {
  flex-shrink: 0;
}

.content {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.deck-row {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 1px solid #2a2a4a;
}

.deck-main {
  display: flex;
  align-items: center;
  flex: 1;
  padding: 24rpx;
}

.deck-color {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.deck-info {
  flex: 1;
}

.deck-name {
  font-size: 30rpx;
  font-weight: bold;
}

.deck-meta {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.deck-delete {
  padding: 24rpx 20rpx;
  font-size: 36rpx;
}

.deck-name-input {
  background: #252550;
  border-radius: 8rpx;
  padding: 16rpx;
  color: #e0e0e0;
  margin-bottom: 20rpx;
}
