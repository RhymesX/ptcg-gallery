<view class="login-page">
  <view class="login-card">
    <view class="login-icon">◆</view>
    <view class="login-title">PTCG 卡牌收藏</view>
    <view class="login-subtitle">先配置线上服务器，再进行微信登录</view>

    <view class="login-form">
      <view class="field-label">API 基址</view>
      <input
        class="server-input"
        placeholder="https://rhymesx.top"
        value="{{apiBaseUrl}}"
        bindinput="onApiBaseUrlInput"
      />
      <view class="button-row">
        <button size="mini" bindtap="saveApiBaseUrl">保存</button>
        <button size="mini" bindtap="testConnection">测试连接</button>
        <button size="mini" bindtap="resetApiBaseUrl">恢复默认</button>
      </view>
      <view wx:if="{{connectionStatus}}" class="connection-status">{{connectionStatus}}</view>
    </view>

    <view class="login-actions">
      <button type="primary" bindtap="doLogin" loading="{{loading}}">微信登录</button>
    </view>

    <view wx:if="{{error}}" class="error-box">
      <view class="error-title">登录失败</view>
      <view class="error-text">{{error}}</view>
    </view>
  </view>
</view>
