.login-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.login-card {
  text-align: center;
  padding: 60rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
  max-width: 680rpx;
}

.login-icon {
  font-size: 100rpx;
  color: #f5b700;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 40rpx;
}

.login-form {
  text-align: left;
  background: #1a1a3e;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.server-input {
  width: 100%;
  box-sizing: border-box;
  background: #252550;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  color: #e0e0e0;
  font-size: 28rpx;
}

.button-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.connection-status {
  margin-top: 14rpx;
  color: #cbd5e1;
  font-size: 24rpx;
  line-height: 1.5;
}

.login-actions {
  margin-bottom: 24rpx;
}

.error-box {
  background: rgba(239, 68, 68, 0.12);
  border: 1rpx solid rgba(239, 68, 68, 0.35);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: left;
}

.error-title {
  font-size: 28rpx;
  color: #fca5a5;
  margin-bottom: 8rpx;
}

.error-text {
  font-size: 24rpx;
  color: #fecaca;
  line-height: 1.5;
}
