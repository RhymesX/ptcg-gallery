.login-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.login-card {
  text-align: center;
  padding: 60rpx;
}

.login-icon {
  font-size: 100rpx;
  color: #f5b700;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 40rpx;
}
