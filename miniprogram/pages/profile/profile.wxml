<view class="page">
  <view class="header">
    <view class="page-title">我的</view>
  </view>

  <scroll-view scroll-y class="content">
    <view class="profile-card">
      <view class="profile-avatar">👤</view>
      <view class="profile-name">{{accountName}}</view>
    </view>

    <view class="setting-group">
      <view class="setting-title">偏好设置</view>
      <view class="setting-row">
        <view class="setting-label">仓库显示图片</view>
        <switch checked="{{showImages}}" bindchange="onShowImagesChange" color="#f5b700" />
      </view>
      <view class="setting-row">
        <view class="setting-label">非宝可梦折叠展示</view>
        <switch checked="{{foldNonPokemon}}" bindchange="onFoldNonPokemonChange" color="#f5b700" />
      </view>
    </view>

    <view class="setting-group">
      <view class="setting-title">工具</view>
      <button class="retire-btn" bindtap="onRetireTap">退标</button>
    </view>

    <view class="setting-group" wx:if="{{isAdmin}}">
      <view class="setting-title">管理员</view>
      <button class="admin-btn" bindtap="onAdminTap">进入管理后台</button>
    </view>

    <view class="setting-group">
      <button class="logout-btn" bindtap="onLogout">退出登录</button>
    </view>
  </scroll-view>

  <view class="navbar">
    <view class="nav-item" bindtap="goToSearch">
      <text class="nav-icon">🔍</text>
      <text>搜索</text>
    </view>
    <view class="nav-item" bindtap="goToHoldings">
      <text class="nav-icon">📦</text>
      <text>仓库</text>
    </view>
    <view class="nav-item" bindtap="goToDecks">
      <text class="nav-icon">🗃</text>
      <text>卡组</text>
    </view>
    <view class="nav-item active">
      <text class="nav-icon">👤</text>
      <text>我的</text>
    </view>
  </view>
</view>
