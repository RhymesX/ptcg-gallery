.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
}

.profile-avatar {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: bold;
}

.setting-group {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.setting-title {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #1a1a3e;
  border-radius: 12rpx;
  padding: 24rpx;
}

.setting-label {
  font-size: 30rpx;
}

.retire-btn {
  width: 100%;
  background: #1a1a3e;
  color: #f87171;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx;
  text-align: center;
}

.retire-btn[disabled] {
  opacity: 0.5;
}

.logout-btn {
  width: 100%;
  background: #ef4444;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx;
  text-align: center;
}
